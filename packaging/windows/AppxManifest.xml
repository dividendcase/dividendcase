<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. build_msix.py fills in the {braces}: the identity comes from
     Partner Center (Product identity), the version from pyproject.toml. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">
  <Identity Name="{identity_name}" Publisher="{publisher}" Version="{version}" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>DividendCase</DisplayName>
    <PublisherDisplayName>{publisher_display_name}</PublisherDisplayName>
    <Description>A dividend tracker that runs on your own computer. Your data stays with you.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <!-- 19041 (Windows 10, version 2004) is the first build that passes uap10:Parameters -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <!-- pythonw has no console window. -I: only the Python and libraries in this package are
         used, whatever Python the computer has and whatever PYTHON* variables are set. -->
    <Application
      Id="DividendCase"
      Executable="python\pythonw.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:Parameters="-I -m dividendcase.desktop --store">
      <uap:VisualElements
        DisplayName="DividendCase"
        Description="A dividend tracker that runs on your own computer. Your data stays with you."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <!-- An ordinary desktop program (a local web server), not a sandboxed Store app -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
