{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:page(login|register|signup|forgot-password|reset-password){/}?",
      "destination": "/#hosted-account",
      "permanent": false
    },
    { "source": "/dashboard/:path*{/}?", "destination": "/#hosted-account", "permanent": false },
    { "source": "/about{/}?", "destination": "/", "permanent": false },
    {
      "source": "/contact{/}?",
      "destination": "/#help",
      "permanent": false
    },
    {
      "source": "/terms{/}?",
      "destination": "https://github.com/dividendcase/dividendcase/blob/main/LICENSE",
      "permanent": false
    }
  ]
}
